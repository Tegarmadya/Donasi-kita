# ==============================================================================
# DonasiKita - Environment Configuration Template (.env.example)
# ==============================================================================
# Petunjuk Pengisian untuk Instalasi Lokal:
# 1. Salin file ini menjadi .env pada direktori utama proyek:
#    - Windows (PowerShell/CMD): copy .env.example .env
#    - Linux / macOS:            cp .env.example .env
#
# 2. Database Configuration:
#    - Pastikan service MySQL/MariaDB (misal XAMPP) telah berstatus Running.
#    - Sesuaikan DB_USER dan DB_PASSWORD sesuai kredensial server lokal Anda
#      (pengguna default XAMPP biasanya DB_USER=root dengan DB_PASSWORD kosong).
#
# 3. Application Secret Key (WAJIB DIISI):
#    - Demi keamanan data, DonasiKita TIDAK lagi menyediakan kunci statis bawaan.
#    - Anda WAJIB membuat kunci rahasia acak yang baru (minimal 16 karakter,
#      disarankan 64 karakter heksadesimal).
#    - Cara membuat kunci rahasia cepat menggunakan Python:
#          python -c "import secrets; print(secrets.token_hex(32))"
#    - Salin output tersebut ke nilai APP_SECRET_KEY di bawah ini.
# ==============================================================================

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=donasikita_db

# Application Configuration
# Kunci rahasia master aplikasi (Wajib diisi, jangan gunakan nilai default statis)
APP_SECRET_KEY=

# Server Network Settings
APP_HOST=localhost
APP_PORT=8000
APP_DEBUG=True
